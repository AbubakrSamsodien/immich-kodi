<?xml version="1.0" encoding="UTF-8"?>
<!--
  The id must never change: Kodi keys userdata/addon_data by it, so renaming
  would orphan every existing user's settings on upgrade.
-->
<addon id="plugin.video.immich"
       version="2.2.0"
       name="Immich"
       provider-name="Immich Kodi contributors">
    <requires>
        <!-- 3.0.1 is Kodi 20 Nexus; Kodi 19 Matrix ships 3.0.0. This addon uses
             getPictureInfoTag, ListItem.setDateTime and the InfoTagVideo
             setters, all of which are @python_v20, so declaring 3.0.0 would let
             Kodi 19 install it and then raise AttributeError on the first
             listing. Verified against addons/xbmc.python/addon.xml on the
             Matrix and Nexus branches. -->
        <import addon="xbmc.python" version="3.0.1"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="addon.py">
        <!-- Section membership comes from this list, not the id prefix. Both
             values are needed so the addon appears under Pictures as well as
             Videos, since it serves stills and video from one tree. -->
        <provides>video image</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Browse your Immich photo and video library</summary>
        <description lang="en_GB">An unofficial plugin for Immich. Browse your library by month, album, person, place, tag or memory, search it by text or by description, and play it back on your TV. Requires an Immich server and an API key.</description>
        <!-- LICENSE.txt is the GPLv3 text, and GitHub detects this repo and
             its upstream as GPL-3.0. The previous MIT tag was simply wrong. -->
        <license>GPL-3.0-or-later</license>
        <source>https://github.com/AbubakrSamsodien/immich-kodi</source>
        <platform>all</platform>
        <!-- Reuses the Python interpreter between navigations. Every module in
             this addon reads sys.argv per invocation, which is the condition
             this requires. -->
        <reuselanguageinvoker>true</reuselanguageinvoker>
        <assets>
            <icon>resources/icon.png</icon>
            <fanart>resources/fanart.jpg</fanart>
        </assets>
        <news>
v2.2.0
- New Video playback setting. On a Raspberry Pi 5, choosing Original plays HEVC video in hardware instead of a software-decoded 720p transcode.
- Added Raspberry Pi 5 guidance to the README.
</news>
    </extension>
</addon>
